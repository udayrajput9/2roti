{
  "version": 2,
  "installCommand": "npm install && npm install --prefix website",
  "buildCommand": "npm run build",
  "outputDirectory": "website/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
