PORT=5000
NODE_ENV=development
# Database (Supabase PostgreSQL / Leave blank for local SQLite)
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
JWT_SECRET=super_secret_jwt_key_2roti_secure_2026_jwt
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_2roti_2026
ALLOW_WEBHOOK_SIMULATOR=true

# Razorpay Test Keys
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=rzp_secret_yourSecretHere
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_yourWebhookSecretHere

# Delivery Fee Config
FREE_DELIVERY_THRESHOLD=100
DEFAULT_DELIVERY_FEE=15
CASHBACK_PER_ORDER=3.00
MIN_WALLET_REDEMPTION=50.00
